---
import Card from './Card.astro';
import Section from './Section.astro';
import { developers } from '@/data/developers';
---

<Section id="developers" title="Developers">
  {
    developers.map((dev) => (
      <Card
        name={dev.name}
        role={dev.role}
        picture={dev.picture}
        socials={dev.socials}
        variant="purple"
      />
    ))
  }
</Section>

---
import Socials from './Socials.astro';
import { site } from '@/data/site';
---

<footer
  class="flex flex-col items-center justify-center
  bg-white dark:bg-gray-950/40 p-5 text-center text-black dark:text-white"
>
  <div class="mb-3 scale-110">
    <Socials
      name={site.name}
      linkedin={site.urls.social.linkedin}
      twitter={site.urls.social.twitter}
    />
  </div>

  <a
    href={site.urls.site}
    target="_blank"
    rel="noopener noreferrer"
    class="mb-3 block text-center"
  >
    DevFest {site.edition}
  </a>

  <div class="mb-3">
    <p class="mb-1 text-sm font-semibold">Ediciones anteriores</p>
    <a
      href={site.urls.pastEditions[2024]}
      target="_blank"
      rel="noopener noreferrer"
      class="block text-center"
    >
      DEVFEST2024
    </a>
    <a
      href={site.urls.pastEditions[2025]}
      target="_blank"
      rel="noopener noreferrer"
      class="block text-center"
    >
      DEVFEST2025
    </a>
  </div>

  <a
    href={site.urls.cfp}
    target="_blank"
    rel="noopener noreferrer"
    class="mb-3 block text-center"
  >
    Convocatoria de ponentes
  </a>
  <a
    href={site.urls.codeOfConduct}
    target="_blank"
    rel="noopener noreferrer"
    class="mb-3 block text-center"
  >
    Código de Conducta
  </a>

  <p class="text-sm text-gray-600 dark:text-gray-200">
    © {site.edition} Todos los derechos reservados.
  </p>
</footer>
